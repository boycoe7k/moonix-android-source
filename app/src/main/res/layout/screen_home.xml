<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/moonix_grey"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/home_search_bar"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/moonix_white"
                app:cardCornerRadius="25dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/moonix_line"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp" android:contentDescription="Search" android:src="@drawable/icon_search" android:tint="@color/moonix_navy" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Search or enter URL" android:textColor="@color/moonix_muted" android:textSize="14sp" />
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Open browser" android:src="@drawable/icon_nav_browser" android:tint="@color/moonix_navy" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <ImageButton android:id="@+id/home_shortcut_profile" android:layout_width="38dp" android:layout_height="44dp" android:layout_marginStart="5dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Profile" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/icon_nav_profile" />
            <ImageButton android:id="@+id/home_shortcut_apps" android:layout_width="38dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Game" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/icon_nav_game" />
            <ImageButton android:id="@+id/home_shortcut_files" android:layout_width="38dp" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="My Files and downloads" android:padding="8dp" android:scaleType="fitCenter" android:src="@drawable/icon_nav_download" />
        </LinearLayout>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="14dp" android:paddingEnd="14dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/home_filter_videos" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="36dp" android:minHeight="36dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Shorts" android:textAllCaps="false" android:textColor="@color/moonix_navy" android:textSize="13sp" app:cornerRadius="18dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/home_filter_all" style="@style/Widget.MaterialComponents.Button" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="7dp" android:minHeight="36dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="All" android:textAllCaps="false" android:textColor="@color/moonix_white" android:textSize="13sp" app:backgroundTint="@color/moonix_navy" app:cornerRadius="18dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/home_filter_subscriptions" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="7dp" android:minHeight="36dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Subscriptions" android:textAllCaps="false" android:textColor="@color/moonix_navy" android:textSize="13sp" app:cornerRadius="18dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/home_filter_music" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="7dp" android:minHeight="36dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Music" android:textAllCaps="false" android:textColor="@color/moonix_navy" android:textSize="13sp" app:cornerRadius="18dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/home_filter_movies" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="7dp" android:minHeight="36dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Movies" android:textAllCaps="false" android:textColor="@color/moonix_navy" android:textSize="13sp" app:cornerRadius="18dp" />
            </LinearLayout>
        </HorizontalScrollView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/home_network_banner" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginStart="16dp" android:layout_marginTop="10dp" android:layout_marginEnd="16dp" android:visibility="gone" app:cardBackgroundColor="#FFFFF0F0" app:cardCornerRadius="9dp" app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Current network is unavailable" android:textColor="@color/moonix_crimson" android:textSize="13sp" />
                <TextView android:id="@+id/home_network_settings" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true" android:text="Settings  ›" android:textColor="@color/moonix_blue" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="10dp" android:paddingEnd="10dp">
                <LinearLayout android:id="@+id/home_youtube" android:layout_width="76dp" android:layout_height="78dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="YouTube" android:src="@drawable/brand_youtube" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="YouTube" android:textColor="@color/moonix_navy" android:textSize="12sp" /></LinearLayout>
                <LinearLayout android:id="@+id/home_whatsapp" android:layout_width="76dp" android:layout_height="78dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="WhatsApp" android:src="@drawable/brand_whatsapp" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="WhatsApp" android:textColor="@color/moonix_navy" android:textSize="12sp" /></LinearLayout>
                <LinearLayout android:id="@+id/home_facebook" android:layout_width="76dp" android:layout_height="78dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="Facebook" android:src="@drawable/brand_facebook" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Facebook" android:textColor="@color/moonix_navy" android:textSize="12sp" /></LinearLayout>
                <LinearLayout android:id="@+id/home_instagram" android:layout_width="76dp" android:layout_height="78dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="Instagram" android:src="@drawable/brand_instagram" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Instagram" android:textColor="@color/moonix_navy" android:textSize="12sp" /></LinearLayout>
                <LinearLayout android:id="@+id/home_sites" android:layout_width="76dp" android:layout_height="78dp" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="46dp" android:layout_height="46dp" android:contentDescription="Sites" android:src="@drawable/icon_nav_browser" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Sites" android:textColor="@color/moonix_navy" android:textSize="12sp" /></LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="7dp" android:paddingEnd="16dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/home_feed_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Popular videos" android:textColor="@color/moonix_navy" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/home_feed_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YouTube search results" android:textColor="@color/moonix_muted" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:id="@+id/home_feed_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="6dp" android:text="Loading YouTube search results…" android:textColor="@color/moonix_muted" android:textSize="12sp" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_feed_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:nestedScrollingEnabled="false" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
