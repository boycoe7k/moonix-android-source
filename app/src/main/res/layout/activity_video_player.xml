<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/moonix_grey">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@color/moonix_navy">
                <VideoView
                    android:id="@+id/video_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <WebView
                    android:id="@+id/youtube_webview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/video_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="24dp"
                    android:background="@drawable/card_surface"
                    android:gravity="center"
                    android:padding="24dp"
                    android:textColor="@color/moonix_navy"
                    android:textSize="16sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/youtube_fallback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="24dp"
                    android:background="@drawable/card_surface"
                    android:gravity="center"
                    android:padding="20dp"
                    android:text="If this video’s embed is disabled, it can’t be played here."
                    android:textColor="@color/moonix_navy"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp">
                <TextView
                    android:id="@+id/video_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Video"
                    android:textColor="@color/moonix_navy"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:maxLines="3" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="6dp">
                    <TextView
                        android:id="@+id/video_creator"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="YouTube"
                        android:textColor="@color/moonix_navy"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/video_duration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/moonix_navy"
                        android:textSize="13sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/video_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="5dp"
                    android:textColor="@color/moonix_navy"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="false"
                    android:scrollbars="none"
                    android:paddingTop="14dp"
                    android:paddingBottom="10dp">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button android:id="@+id/action_save" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Save" />
                        <Button android:id="@+id/action_audio" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="Download Audio" />
                        <Button android:id="@+id/action_share" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="Share" />
                        <Button android:id="@+id/action_download" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="8dp" android:text="Download" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A17243A" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About this video"
                    android:textColor="@color/moonix_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/video_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textColor="@color/moonix_navy"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="24dp"
                    android:text="Recommended videos"
                    android:textColor="@color/moonix_navy"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/recommendation_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:text="Explore more videos from search results to find your next watch."
                    android:textColor="@color/moonix_navy"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
