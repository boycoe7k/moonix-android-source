<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardBackgroundColor="@color/moonix_white"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/moonix_line"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="196dp"
            android:background="@color/moonix_lavender">
            <ImageView
                android:id="@+id/home_video_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Video thumbnail"
                android:scaleType="centerCrop" />
            <TextView
                android:id="@+id/home_video_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="#CC10182D"
                android:paddingStart="6dp"
                android:paddingTop="3dp"
                android:paddingEnd="6dp"
                android:paddingBottom="3dp"
                android:textColor="@color/moonix_white"
                android:textSize="11sp"
                android:visibility="gone" />
        </FrameLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="8dp">
            <TextView
                android:id="@+id/home_video_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/moonix_navy"
                android:textSize="15sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/home_video_more"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="More video actions"
                android:src="@android:drawable/ic_menu_more"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/home_video_creator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/moonix_muted"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_video_play"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Play on YouTube"
                android:textAllCaps="false"
                android:textColor="@color/moonix_navy"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_media_play"
                app:iconTint="@color/moonix_navy" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_video_download"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Download"
                android:textAllCaps="false"
                android:textSize="12sp"
                app:backgroundTint="@color/moonix_pink"
                app:cornerRadius="12dp"
                app:icon="@drawable/icon_nav_download"
                app:iconTint="@color/moonix_white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
