<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile &amp; settings"
            android:textColor="@color/moonix_navy"
            android:textSize="23sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Personalize Moonix and its download behavior."
            android:textColor="@color/moonix_muted"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/moonix_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VDL API connection"
                    android:textColor="@color/moonix_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="API base URL"
                    app:boxBackgroundMode="outline">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_api_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="Optional API key"
                    app:boxBackgroundMode="outline"
                    app:endIconMode="password_toggle">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/profile_api_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_save"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Save API connection"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/moonix_pink"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="@color/moonix_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Download settings"
                    android:textColor="@color/moonix_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="No subscription tiers or paid download gates. Unlimited concurrency is available."
                    android:textColor="@color/moonix_muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Default video quality"
                    android:textColor="@color/moonix_navy"
                    android:textSize="13sp" />
                <Spinner
                    android:id="@+id/profile_quality"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/quality_options" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Audio output is MP3; bitrate is determined by the VDL API."
                    android:textColor="@color/moonix_muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Default movie quality"
                    android:textColor="@color/moonix_navy"
                    android:textSize="13sp" />
                <Spinner
                    android:id="@+id/profile_movie_quality"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/movie_quality_options" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Maximum downloads at once"
                    android:textColor="@color/moonix_navy"
                    android:textSize="13sp" />
                <Spinner
                    android:id="@+id/profile_max_downloads"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/max_download_options" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Save downloaded files to"
                    android:textColor="@color/moonix_navy"
                    android:textSize="13sp" />
                <Spinner
                    android:id="@+id/profile_download_location"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/download_location_options" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/profile_wifi_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Transfer files on Wi-Fi only" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/profile_allow_roaming"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allow downloads while roaming" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/profile_notify_complete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Notify when downloads complete" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/profile_confirm_download"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ask before queuing a download" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/profile_save_download_settings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="Save download settings"
                    android:textAllCaps="false"
                    app:backgroundTint="@color/moonix_pink"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/moonix_white"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="About Moonix"
                    android:textColor="@color/moonix_navy"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Moonix · Video Downloader &amp; Media Manager\nDownload. Discover. Enjoy.\n\nUse downloads only for content you own or are permitted to save. Source sites may restrict downloading. Moonix does not bypass DRM or access controls."
                    android:textColor="@color/moonix_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
