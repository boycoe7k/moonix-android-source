<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/moonix_grey">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp"
        android:background="@drawable/card_surface">
        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="Audio"
            android:scaleType="fitCenter"
            android:src="@drawable/icon_audio" />
        <TextView
            android:id="@+id/music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Audio"
            android:textColor="@color/moonix_navy"
            android:textSize="21sp"
            android:textStyle="bold"
            android:maxLines="2" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="On this device"
            android:textColor="@color/moonix_muted"
            android:textSize="14sp" />
        <LinearLayout
            android:id="@+id/music_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">
            <SeekBar
                android:id="@+id/music_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:progressTint="@color/moonix_purple"
                android:thumbTint="@color/moonix_pink" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/music_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@color/moonix_muted"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/music_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/moonix_muted"
                    android:textSize="13sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/music_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="18dp"
                android:enabled="false"
                android:text="Play"
                android:textAllCaps="false"
                android:textColor="@color/moonix_white"
                app:backgroundTint="@color/moonix_purple"
                app:cornerRadius="24dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/music_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/moonix_navy"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
