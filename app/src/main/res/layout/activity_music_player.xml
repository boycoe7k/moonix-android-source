<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/moonix_grey">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOW PLAYING"
            android:textColor="@color/moonix_muted"
            android:textSize="12sp"
            android:letterSpacing="0.14"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/music_art"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="28dp"
            android:adjustViewBounds="true"
            android:background="@drawable/card_surface"
            android:contentDescription="Album cover"
            android:scaleType="centerCrop"
            android:src="@drawable/icon_audio" />

        <TextView
            android:id="@+id/music_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Audio"
            android:textColor="@color/moonix_navy"
            android:textSize="25sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/music_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Unknown artist"
            android:textColor="@color/moonix_navy"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/music_album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Unknown album"
            android:textColor="@color/moonix_muted"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:id="@+id/music_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/music_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:progressTint="@color/moonix_purple"
                android:thumbTint="@color/moonix_pink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/music_elapsed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0:00"
                    android:textColor="@color/moonix_muted"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/music_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/moonix_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_shuffle"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:contentDescription="Shuffle off"
                    android:text=""
                    app:icon="@drawable/icon_shuffle"
                    app:iconTint="@null" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_previous"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:contentDescription="Restart current track"
                    android:text=""
                    app:icon="@drawable/icon_previous"
                    app:iconTint="@null" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_play_pause"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:enabled="false"
                    android:contentDescription="Play"
                    android:text=""
                    app:backgroundTint="@color/moonix_purple"
                    app:icon="@drawable/icon_play"
                    app:iconTint="@color/moonix_white"
                    app:cornerRadius="36dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_next"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:contentDescription="Next track; no queue available"
                    android:text=""
                    app:icon="@drawable/icon_next"
                    app:iconTint="@null" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/music_repeat"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:contentDescription="Repeat off"
                    android:text=""
                    app:icon="@drawable/icon_repeat"
                    app:iconTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/music_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/moonix_navy"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
